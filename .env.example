# Docker Compose listens only on this computer by default.
# Use 0.0.0.0 only on a trusted LAN/VPN and after reading SECURITY.md.
MIRDAIN_BIND_ADDRESS=127.0.0.1
MIRDAIN_WEB_PORT=8080

# Exact dashboard hostnames/IPs permitted beyond localhost, separated by spaces.
# Required for LAN/VPN access; never use wildcards and do not include a scheme.
MIRDAIN_ALLOWED_HOSTS=

# Optional Fernet key for managed/headless deployments. If omitted, Mirdain
# creates backend/data/.secret-key automatically. Keep either key with backups.
# Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MIRDAIN_SECRET_KEY=

# Optional Bearer token for /api/public/v1 automation endpoints only.
# This does not authenticate the dashboard or its internal control routes.
# Generate a strong value with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MIRDAIN_API_TOKEN=

# Local launcher settings (optional; set these in your shell before npm run local).
MIRDAIN_API_PORT=8765
MIRDAIN_LOCAL_WEB_PORT=5174
MIRDAIN_OPEN_BROWSER=true
